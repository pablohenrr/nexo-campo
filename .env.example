POSTGRES_DB=nexocampo
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-local-password
DB_URL=jdbc:postgresql://localhost:5432/nexocampo
DB_USERNAME=postgres
DB_PASSWORD=replace-with-local-password
JWT_SECRET=gere-um-segredo-aleatorio-com-pelo-menos-32-bytes
JWT_EXPIRATION=86400000
# Google OAuth/OIDC: instruções em docs/api/google-oauth.md.
# Ative somente após criar o cliente Web no Google Cloud; segredo fica apenas no backend.
GOOGLE_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/login/oauth2/code/google
GOOGLE_FRONTEND_ORIGIN=http://localhost:5173
# true em produção HTTPS; false somente em localhost HTTP.
SESSION_COOKIE_SECURE=false
CORS_ALLOWED_ORIGINS=http://localhost:5173
MAX_FILE_SIZE=2GB
MAX_REQUEST_SIZE=2GB
STORAGE_ROOT=./storage

# IA (docs/api/ingestao-ia.md). Com AI_PROVIDER=stub tudo funciona sem chave, com respostas simuladas.
AI_PROVIDER=stub
# Texto e foto: Gemini pela API compatível com OpenAI. Chave grátis em https://aistudio.google.com/apikey
AI_CHAT_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_CHAT_API_KEY=
AI_CHAT_MODEL=gemini-3.5-flash-lite
# Áudio: Whisper na Groq. Chave grátis em https://console.groq.com/keys
AI_TRANSCRIPTION_BASE_URL=https://api.groq.com/openai/v1
AI_TRANSCRIPTION_API_KEY=
AI_TRANSCRIPTION_MODEL=whisper-large-v3-turbo

# Alertas climáticos. INMET não usa chave. Open-Meteo funciona sem chave; preencha só se tiver chave comercial.
# stub = sem rede. reais = consulta INMET e Open-Meteo. O perfil dev já força fontes=reais em application-dev.yml.
ALERTAS_AGENDAMENTO=true
ALERTAS_FONTES=reais
ALERTAS_CRON=0 */15 * * * *
INMET_AVISOS_URL=https://apiprevmet3.inmet.gov.br/avisos/rss
OPEN_METEO_URL=https://api.open-meteo.com
OPEN_METEO_API_KEY=
ALERTAS_TIMEOUT=15s
