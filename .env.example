POSTGRES_DB=nexocampo
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-local-password
DB_URL=jdbc:postgresql://localhost:5432/nexocampo
DB_USERNAME=postgres
DB_PASSWORD=replace-with-local-password
JWT_SECRET=gere-um-segredo-aleatorio-com-pelo-menos-32-bytes
JWT_EXPIRATION=86400000
CORS_ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173
GOOGLE_CLIENT_ID=143930353123-gl5sao18jsp0f5u8ela7cbp0t16lnrrj.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=
MAX_FILE_SIZE=2GB
MAX_REQUEST_SIZE=2GB
STORAGE_ROOT=./storage

# IA (docs/api/ingestao-ia.md). Com AI_PROVIDER=stub tudo funciona sem chave, com respostas simuladas.
AI_PROVIDER=stub
# Texto e foto: Gemini pela API compatível com OpenAI. Chave grátis em https://aistudio.google.com/apikey
AI_CHAT_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_CHAT_API_KEY=
AI_CHAT_MODEL=gemini-3.5-flash-lite
# Áudio: Whisper na Groq. Chave grátis em https://console.groq.com/keys
AI_TRANSCRIPTION_BASE_URL=https://api.groq.com/openai/v1
AI_TRANSCRIPTION_API_KEY=
AI_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
