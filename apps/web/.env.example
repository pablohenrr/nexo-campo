# Copie para .env.local no mesmo diretório e reinicie o Vite.
# Chave web do MapTiler Cloud. Autorize localhost ou 127.0.0.1 conforme o endereço usado.
# No deploy, configure VITE_MAPTILER_KEY para o domínio da aplicação antes do build.
# Variáveis VITE_ são visíveis no navegador. Use uma chave web com origens restritas.
VITE_MAPTILER_KEY=
