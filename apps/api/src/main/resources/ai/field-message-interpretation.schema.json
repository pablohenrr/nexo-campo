{
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "enum": ["ATIVIDADE", "OCORRENCIA", "OUTRO"],
      "description": "ATIVIDADE = trabalho feito no talhão; OCORRENCIA = problema observado; OUTRO = qualquer outra coisa"
    },
    "plotName": {
      "type": "string",
      "description": "Nome exato de um dos talhões do produtor. Omita se a mensagem não indicar o talhão com segurança."
    },
    "summary": {
      "type": "string",
      "description": "Frase curta em português confirmando o que foi entendido"
    },
    "activity": {
      "type": "object",
      "description": "Somente quando kind = ATIVIDADE",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["PLANTIO", "ADUBACAO", "PULVERIZACAO", "IRRIGACAO", "CAPINA", "COLHEITA", "MONITORAMENTO", "MANUTENCAO", "OUTRO"]
        },
        "date": {
          "type": "string",
          "description": "Data da atividade no formato AAAA-MM-DD"
        },
        "description": {
          "type": "string"
        },
        "inputs": {
          "type": "string",
          "description": "Produtos e quantidades citados, separados por ponto e vírgula"
        },
        "cost": {
          "type": "number",
          "description": "Custo total em reais"
        }
      },
      "required": ["type", "date", "description"]
    },
    "occurrence": {
      "type": "object",
      "description": "Somente quando kind = OCORRENCIA",
      "properties": {
        "category": {
          "type": "string",
          "enum": ["PRAGA", "DOENCA", "PLANTA_DANINHA", "DEFICIENCIA_NUTRICIONAL", "CLIMA", "OUTRO"]
        },
        "severity": {
          "type": "string",
          "enum": ["BAIXA", "MEDIA", "ALTA"]
        },
        "description": {
          "type": "string",
          "description": "O que foi observado e a hipótese mais provável, deixando claro que é suspeita"
        }
      },
      "required": ["category", "severity", "description"]
    },
    "missingFields": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["plotName", "date", "inputs", "cost", "description"]
      }
    },
    "confidence": {
      "type": "number",
      "description": "Segurança da interpretação, de 0 a 1"
    }
  },
  "required": ["kind", "summary", "missingFields", "confidence"]
}
